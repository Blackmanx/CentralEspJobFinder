# Clave de API de Google Gemini (Obtenla en https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_api_aqui

# Configuración SMTP (para envío automatizado por CLI o Raspberry Pi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_usuario@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
EMAIL_FROM=tu_usuario@gmail.com
EMAIL_TO=destinatario_por_defecto@gmail.com
